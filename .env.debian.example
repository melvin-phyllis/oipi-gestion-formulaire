# OIPI Suivi PI - modèle de configuration pour un serveur Debian.
# Copier ce fichier vers .env puis remplacer toutes les valeurs entre <...>.
# Ne jamais committer le vrai fichier .env ni transmettre ses secrets.

# Application et domaine HTTPS.
APP_NAME="OIPI Suivi PI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<VOTRE-DOMAINE>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Sécurité des mots de passe et journalisation de production.
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL ou MariaDB locale au serveur Debian.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oipi_risfm
DB_USERNAME=risfm_user
DB_PASSWORD=<MOT_DE_PASSE_MYSQL_FORT>

# Sessions persistantes et cookies sécurisés.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<VOTRE-DOMAINE>
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Notifications en temps réel Pusher.
# Le secret reste uniquement côté serveur. Les valeurs VITE_* sont publiques.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=<PUSHER_APP_ID>
PUSHER_APP_KEY=<PUSHER_APP_KEY>
PUSHER_APP_SECRET=<PUSHER_APP_SECRET>
PUSHER_APP_CLUSTER=eu
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Fichiers privés, file d'attente et cache partagé.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Doit rester supérieur au timeout de 3 600 secondes du worker.
DB_QUEUE_RETRY_AFTER=3900
CACHE_STORE=database

# Serveur SMTP utilisé pour les courriels et le compte administrateur initial.
# Port 587 : MAIL_SCHEME=null. Port 465 : MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<SERVEUR_SMTP>
MAIL_PORT=587
MAIL_USERNAME=<ADRESSE_EMAIL_COMPLETE>
MAIL_PASSWORD=<MOT_DE_PASSE_EMAIL>
MAIL_FROM_ADDRESS=<ADRESSE_EMAIL_COMPLETE>
MAIL_FROM_NAME="${APP_NAME}"
