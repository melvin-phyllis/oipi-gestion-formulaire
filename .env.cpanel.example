# OIPI Suivi PI - modèle de configuration de production pour cPanel.
# Copier ce fichier vers .env sur le serveur et remplacer chaque valeur entre <...>.
# Ne jamais committer le vrai fichier .env ni partager ses secrets.

APP_NAME="OIPI Suivi PI"
APP_ENV=production
APP_KEY=<GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE>
APP_DEBUG=false
APP_URL=https://<VOTRE-DOMAINE>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<PREFIXE_CPANEL>_oipi_risfm
DB_USERNAME=<PREFIXE_CPANEL>_risfm
DB_PASSWORD=<MOT_DE_PASSE_MYSQL_FORT>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<VOTRE-DOMAINE>

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=<PUSHER_APP_ID>
PUSHER_APP_KEY=<PUSHER_APP_KEY>
PUSHER_APP_SECRET=<PUSHER_APP_SECRET>
PUSHER_APP_CLUSTER=eu
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900
CACHE_STORE=database

# SMTP cPanel : utiliser les paramètres fournis par l'hébergeur.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<SERVEUR_SMTP_CPANEL>
MAIL_PORT=587
MAIL_USERNAME=<ADRESSE_EMAIL_COMPLETE>
MAIL_PASSWORD=<MOT_DE_PASSE_EMAIL>
MAIL_FROM_ADDRESS=<ADRESSE_EMAIL_COMPLETE>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
