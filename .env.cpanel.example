# OIPI Suivi PI - modèle de configuration de production pour cPanel.
# Copier ce fichier vers .env sur le serveur et remplacer chaque valeur entre <...>.
# Ne jamais committer le vrai fichier .env ni partager ses secrets.

# Application : nom affiché, environnement de production, domaine et langue.
# Générer APP_KEY une seule fois avec : php artisan key:generate
APP_NAME="OIPI Suivi PI"
APP_ENV=production
APP_KEY=<GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE>
APP_DEBUG=false
APP_URL=https://<VOTRE-DOMAINE>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

# Mots de passe : coût de calcul utilisé par Bcrypt.
BCRYPT_ROUNDS=12

# Journaux : enregistrer les erreurs utiles sans activer le mode debug en production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de données : utiliser les noms complets générés par cPanel, préfixes compris.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<PREFIXE_CPANEL>_oipi_risfm
DB_USERNAME=<PREFIXE_CPANEL>_risfm
DB_PASSWORD=<MOT_DE_PASSE_MYSQL_FORT>

# Sessions : stockage en base, durée en minutes et chiffrement activé.
# SESSION_DOMAIN contient uniquement le domaine, sans https:// ni chemin.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<VOTRE-DOMAINE>

# Temps réel : identifiants Pusher Channels utilisés par Laravel et le frontend Vite.
# PUSHER_APP_SECRET reste strictement côté serveur.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=<PUSHER_APP_ID>
PUSHER_APP_KEY=<PUSHER_APP_KEY>
PUSHER_APP_SECRET=<PUSHER_APP_SECRET>
PUSHER_APP_CLUSTER=eu
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stockage : fichiers privés conservés par Laravel hors du dossier public.
FILESYSTEM_DISK=local

# File d’attente : traitements asynchrones des imports et notifications.
# 3900 secondes (65 min) doit rester supérieur au timeout du worker (3600 s).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900

# Cache : stockage partagé en base, nécessaire aux verrous du planificateur.
CACHE_STORE=database

# Courriels : paramètres SMTP fournis par l’hébergeur cPanel.
# Pour le port 465 avec TLS implicite, utiliser MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<SERVEUR_SMTP_CPANEL>
MAIL_PORT=587
MAIL_USERNAME=<ADRESSE_EMAIL_COMPLETE>
MAIL_PASSWORD=<MOT_DE_PASSE_EMAIL>
MAIL_FROM_ADDRESS=<ADRESSE_EMAIL_COMPLETE>
MAIL_FROM_NAME="${APP_NAME}"
